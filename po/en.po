#: data/io.github.vellum.Vellum.desktop:2
#: data/io.github.vellum.Vellum.metainfo.xml:4
msgid "Vellum"
msgstr "Vellum"

#: data/io.github.vellum.Vellum.desktop:4
#: data/io.github.vellum.Vellum.metainfo.xml:5
msgid "A focused GTK4 text editor"
msgstr "A focused GTK4 text editor"

#: data/io.github.vellum.Vellum.desktop:13
msgid "Text;Editor;Write;Code;"
msgstr "Text;Editor;Write;Code;"

#: data/io.github.vellum.Vellum.metainfo.xml:9
msgid ""
"Vellum is a clean, focused text editor built with GTK4, Libadwaita and "
"GtkSourceView."
msgstr "Vellum is a clean, focused text editor built with GTK4, Libadwaita and GtkSourceView."

#: data/io.github.vellum.Vellum.metainfo.xml:10
msgid ""
"It supports multiple documents, syntax highlighting, search and replace, "
"local draft recovery, and C plugins."
msgstr "It supports multiple documents, syntax highlighting, search and replace, local draft recovery, and C plugins."

#: data/io.github.vellum.Vellum.metainfo.xml:24
msgid "Vellum contributors"
msgstr "Vellum contributors"

#: data/io.github.vellum.Vellum.metainfo.xml:29
msgid ""
"Fix AI inline completion ghost text not disappearing on accept or reject."
msgstr "Fix AI inline completion ghost text not disappearing on accept or reject."

#: data/io.github.vellum.Vellum.metainfo.xml:30
msgid ""
"Restrict automatic AI completion to code documents to avoid chat-like "
"suggestions."
msgstr "Restrict automatic AI completion to code documents to avoid chat-like suggestions."

#: data/io.github.vellum.Vellum.metainfo.xml:31
msgid ""
"Make auto-pair brackets work in both normal and Vi insert mode, with a new "
"preference toggle."
msgstr "Make auto-pair brackets work in both normal and Vi insert mode, with a new preference toggle."

#: data/io.github.vellum.Vellum.metainfo.xml:32
msgid "Add Vi mode yy (yank line), cc (change line) and p (paste)."
msgstr "Add Vi mode yy (yank line), cc (change line) and p (paste)."

#: data/io.github.vellum.Vellum.metainfo.xml:33
msgid ""
"Clean up draft snapshots on discard, snapshot on exit, and skip empty drafts."
msgstr "Clean up draft snapshots on discard, snapshot on exit, and skip empty drafts."

#: data/io.github.vellum.Vellum.metainfo.xml:38
msgid "Unify the application display name as Vellum in all languages."
msgstr "Unify the application display name as Vellum in all languages."

#: data/io.github.vellum.Vellum.metainfo.xml:39
msgid ""
"Allow removing built-in extensions from the Extensions window, with removal "
"persisted across restarts."
msgstr "Allow removing built-in extensions from the Extensions window, with removal persisted across restarts."

#: data/io.github.vellum.Vellum.metainfo.xml:40
msgid ""
"Add a welcome guide plugin that introduces the editor and asks to remove "
"itself after the tour."
msgstr "Add a welcome guide plugin that introduces the editor and asks to remove itself after the tour."

#: data/io.github.vellum.Vellum.metainfo.xml:45
msgid ""
"Guard AI completion requests with lifecycle generations and make inline "
"candidate overlays follow their owning document safely across tab switches "
"and document destruction."
msgstr "Guard AI completion requests with lifecycle generations and make inline candidate overlays follow their owning document safely across tab switches and document destruction."

#: data/io.github.vellum.Vellum.metainfo.xml:46
msgid ""
"Add a restartable core-only mode that loads no extensions, stabilize "
"automatic local Markdown Mode detection against hidden markup, and include a "
"restricted TUI GTK debugging helper for repeatable regression checks."
msgstr "Add a restartable core-only mode that loads no extensions, stabilize automatic local Markdown Mode detection against hidden markup, and include a restricted TUI GTK debugging helper for repeatable regression checks."

#: data/io.github.vellum.Vellum.metainfo.xml:47
msgid ""
"Refine external-file change notifications into a two-line banner below the "
"header bar."
msgstr "Refine external-file change notifications into a two-line banner below the header bar."

#: data/io.github.vellum.Vellum.metainfo.xml:52
msgid ""
"Add editable persistent shortcuts, zoom reset, automatic local Markdown "
"Mode, and a 50%-opacity inline AI completion candidate accepted with Tab or "
"dismissed with Escape."
msgstr "Add editable persistent shortcuts, zoom reset, automatic local Markdown Mode, and a 50%-opacity inline AI completion candidate accepted with Tab or dismissed with Escape."

#: data/io.github.vellum.Vellum.metainfo.xml:53
msgid ""
"Add safe external-file change notifications with discard-and-reload, a Vi-"
"compatible command prompt, a standalone Build & Run tool window, lifecycle "
"guards, and an original Vellum application icon."
msgstr "Add safe external-file change notifications with discard-and-reload, a Vi-compatible command prompt, a standalone Build & Run tool window, lifecycle guards, and an original Vellum application icon."

#: data/io.github.vellum.Vellum.metainfo.xml:58
msgid ""
"Replace document saving with a standard GIO asynchronous replace operation "
"so file-system writes no longer block the editor interface."
msgstr "Replace document saving with a standard GIO asynchronous replace operation so file-system writes no longer block the editor interface."

#: data/io.github.vellum.Vellum.metainfo.xml:59
msgid ""
"Add save-in-progress protection and visible save status, including a "
"regression test for the actual window save action."
msgstr "Add save-in-progress protection and visible save status, including a regression test for the actual window save action."

#: data/io.github.vellum.Vellum.metainfo.xml:64
msgid ""
"Add an independent visual code-theme chooser with live GtkSourceView C "
"syntax previews and persistent selection."
msgstr "Add an independent visual code-theme chooser with live GtkSourceView C syntax previews and persistent selection."

#: data/io.github.vellum.Vellum.metainfo.xml:65
msgid ""
"Escape extension metadata before rendering it as Adwaita markup, fixing "
"Build & Run settings warnings; make extension controls compact icon actions "
"with tooltips."
msgstr "Escape extension metadata before rendering it as Adwaita markup, fixing Build & Run settings warnings; make extension controls compact icon actions with tooltips."

#: data/io.github.vellum.Vellum.metainfo.xml:70
msgid ""
"Add validated .vut ZIP extension packages and ship all built-in extensions "
"as auditable source packages that can be rebuilt for the local Linux "
"architecture."
msgstr "Add validated .vut ZIP extension packages and ship all built-in extensions as auditable source packages that can be rebuilt for the local Linux architecture."

#: data/io.github.vellum.Vellum.metainfo.xml:71
msgid ""
"Add persistent extension enable switches, Project Sidebar, Build & Run, "
"Markdown Preview, Vim Mode, an overview map, editor display and indentation "
"preferences, and a keyboard shortcut reference."
msgstr "Add persistent extension enable switches, Project Sidebar, Build & Run, Markdown Preview, Vim Mode, an overview map, editor display and indentation preferences, and a keyboard shortcut reference."

#: data/io.github.vellum.Vellum.metainfo.xml:76
msgid ""
"Add configurable real-tab display widths, live content-aware language "
"recognition, and heuristic red error underlines for unbalanced brackets and "
"quotes."
msgstr "Add configurable real-tab display widths, live content-aware language recognition, and heuristic red error underlines for unbalanced brackets and quotes."

#: data/io.github.vellum.Vellum.metainfo.xml:77
msgid ""
"Add the manual Test Links extension, make saved OpenAI-compatible /v1 "
"addresses work for AI Completion, and ship the project under BSD-2-Clause "
"after a source and asset audit."
msgstr "Add the manual Test Links extension, make saved OpenAI-compatible /v1 addresses work for AI Completion, and ship the project under BSD-2-Clause after a source and asset audit."

#: data/io.github.vellum.Vellum.metainfo.xml:82
msgid ""
"Rework the dark editor surface around Libadwaita and GtkSourceView Adwaita-"
"dark, add extension import/export/removal/configuration, and add a user-"
"configured AI completion extension."
msgstr "Rework the dark editor surface around Libadwaita and GtkSourceView Adwaita-dark, add extension import/export/removal/configuration, and add a user-configured AI completion extension."

#: data/io.github.vellum.Vellum.metainfo.xml:87
msgid ""
"Add explicit English and Simplified Chinese language packs, custom editor "
"fonts, enhanced dark source themes, content-aware language recognition, and "
"extension management."
msgstr "Add explicit English and Simplified Chinese language packs, custom editor fonts, enhanced dark source themes, content-aware language recognition, and extension management."


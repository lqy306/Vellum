install_data(
  'io.github.vellum.Vellum.desktop',
  install_dir : join_paths(get_option('datadir'), 'applications')
)

install_data(
  'io.github.vellum.Vellum.metainfo.xml',
  install_dir : join_paths(get_option('datadir'), 'metainfo')
)

install_data(
  'icons/hicolor/scalable/apps/io.github.vellum.Vellum.svg',
  install_dir : join_paths(get_option('datadir'), 'icons', 'hicolor', 'scalable', 'apps')
)

install_data(
  'extension-intros/ai-completion.ini',
  'extension-intros/timestamp.ini',
  'extension-intros/word-count.ini',
  'extension-intros/link-check.ini',
  'extension-intros/project-sidebar.ini',
  'extension-intros/build-run.ini',
  'extension-intros/vim-mode.ini',
  'extension-intros/screenshot.ini',
  install_dir : join_paths(get_option('datadir'), 'vellum', 'extension-intros')
)
